# Normalize line endings: store LF in the repo, check out native on each OS.
* text=auto eol=lf

# Treat these as binary (never normalize / diff as text).
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.avif binary
*.ico binary
*.woff binary
*.woff2 binary
*.pdf binary

# fleet live-kit copies are byte-locked: never let a checkout rewrite their line endings
lib/live/** text eol=lf
scripts/live/** text eol=lf
content/live/_calendar*.json text eol=lf
public/assets/live.js text eol=lf
live-kit.lock.json text eol=lf
