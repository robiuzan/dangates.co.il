{
  "name": "dangates",
  "version": "0.1.0",
  "private": true,
  "description": "דן שערים חשמליים (Dan Electric Gates) — electric gate repair & installation service website. Hebrew, RTL, Next.js App Router.",
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/gen-redirects.mjs && node scripts/live/check-live-copy.mjs && node scripts/live/check-live-register.mjs && node scripts/live/check-live-schedule.mjs",
    "build": "next build",
    "postbuild": "node scripts/live/check-live-out.mjs",
    "start": "next start",
    "lint": "next lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "redirects": "node scripts/gen-redirects.mjs",
    "audit": "node scripts/audit/run-all.mjs",
    "audit:env": "node scripts/audit/env-doctor.mjs",
    "gate": "npm run lint && npm run typecheck && npm run format:check && npm run build && npm run audit",
    "live:remind": "node scripts/live/check-reminders.mjs"
  },
  "dependencies": {
    "@ishub/site-kit": "file:vendor/ishub-site-kit-0.0.0.tgz",
    "clsx": "^2.1.1",
    "lucide-react": "^0.439.0",
    "next": "^14.2.13",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.2",
    "@types/node": "^20.16.5",
    "@types/react": "^18.3.7",
    "@types/react-dom": "^18.3.0",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.13",
    "postcss": "^8.4.47",
    "prettier": "^3.3.3",
    "prettier-plugin-tailwindcss": "^0.6.8",
    "tailwindcss": "^4.3.2",
    "typescript": "^5.6.2"
  },
  "engines": {
    "node": ">=18.18.0"
  }
}
